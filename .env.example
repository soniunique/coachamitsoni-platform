# CoachAmitSoni LMS — Supabase environment
# Copy this file to .env.local for local development.
#
# IMPORTANT:
# - Never commit .env.local.
# - Use the Supabase PUBLISHABLE key only in the browser.
# - Never put a sb_secret_* or service-role key in VITE_* variables.

VITE_SUPABASE_URL=https://mszzavokfsayxxfreono.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# Server-side aliases used by TanStack Start middleware.
# These may use the same publishable key; they must NOT be a secret/service-role key.
SUPABASE_URL=https://mszzavokfsayxxfreono.supabase.co
SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# Only required later if trusted server-side admin operations are introduced.
# Never expose this as VITE_* and never commit it.
# SUPABASE_SERVICE_ROLE_KEY=
